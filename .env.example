# ============================================================
# SUPABASE ENVIRONMENT VARIABLES — HOW TO FILL THESE IN
# ============================================================
#
# STEP 1: Create a free Supabase project
#   → Go to https://supabase.com and sign in (GitHub login works great)
#   → Click "New project"
#   → Choose a name, set a strong database password, pick the region
#     closest to you, then click "Create new project"
#   → Wait ~2 minutes for the project to be ready
#
# STEP 2: Copy the values from your project dashboard
#   → In Supabase, open your project
#   → Click "Project Settings" (gear icon, bottom-left sidebar)
#   → Click "Data" → "Database" for the connection strings
#     OR click "API" for the URL and keys
#
# ============================================================

# ------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL
#   Where to find it:
#     Project Settings → API → "Project URL"
#     It looks like: https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# ------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_ANON_KEY
#   Where to find it:
#     Project Settings → API → "Project API keys" → "anon" / "public"
#     It is the long JWT token labelled "anon public"
#     It is safe to expose in browser code (row-level security protects the data)
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY
#   Where to find it:
#     Project Settings → API → "Project API keys" → "service_role" / "secret"
#     WARNING: Keep this secret! Never expose it in client-side code or
#     commit it to git. It bypasses Row Level Security.
# ------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------
# DATABASE_URL  (used by Prisma at runtime, goes through PgBouncer)
#   Where to find it:
#     Project Settings → Database → "Connection string" tab
#     Select "URI" mode, then choose "Transaction" pooler (port 6543)
#     Copy the URI — it looks like:
#       postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
#     Replace [YOUR-PASSWORD] with the database password you set when
#     creating the project.
#
#   The ?pgbouncer=true flag tells Prisma to use PgBouncer connection pooling.
# ------------------------------------------------------------
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# ------------------------------------------------------------
# DIRECT_URL  (used by Prisma Migrate — bypasses PgBouncer)
#   Where to find it:
#     Project Settings → Database → "Connection string" tab
#     Select "URI" mode, then choose "Session" pooler (port 5432)
#     OR use the direct connection string (also port 5432):
#       postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxxxxxxxxxx.supabase.co:5432/postgres
#     Replace [YOUR-PASSWORD] with your database password.
#
#   This direct connection is needed for `prisma migrate` because
#   PgBouncer does not support the prepared statements that migrations use.
# ------------------------------------------------------------
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxxxxxxxxxx.supabase.co:5432/postgres
